# Porta em que o frontend fica disponível no host (http://localhost:3000)
FRONTEND_PORT=3000

# Para onde o Nginx (Docker) ou o Vite (npm run dev) repassa as chamadas /api.
# - docker compose com o backend junto: http://app:8080 (padrão do compose)
# - npm run dev com o backend rodando no host: http://localhost:8080
# BACKEND_URL=http://localhost:8080

# Caminho do clone local do backend, usado pelo docker-compose.yml para subir tudo junto
BACKEND_PATH=../17SOAT-workshop-management-system
